<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Glowing Particle Heart</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #000;
    overflow: hidden;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
}
</style>
</head>

<body>

<canvas id="heart"></canvas>

<script>
const canvas = document.getElementById("heart");
const ctx = canvas.getContext("2d");

let width, height;
let particles = [];

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    width = canvas.width;
    height = canvas.height;

    createParticles();
}

window.addEventListener("resize", resize);

// Heart shape formula
function heartShape(t) {
    const x = 16 * Math.pow(Math.sin(t), 3);
    const y = -(13 * Math.cos(t)
        - 5 * Math.cos(2*t)
        - 2 * Math.cos(3*t)
        - Math.cos(4*t));

    return { x, y };
}

// Create particles
function createParticles() {
    particles = [];

    const scale = Math.min(width, height) / 38;

    for (let i = 0; i < 1800; i++) {

        const t = Math.random() * Math.PI * 2;
        const point = heartShape(t);

        const fill = Math.random();

        const spread = fill < 0.65
            ? Math.sqrt(Math.random())
            : 1 + Math.random() * 0.12;

        particles.push({
            x: width / 2 + point.x * scale * spread,
            y: height / 2 - 40 + point.y * scale * spread,
            size: Math.random() * 1.8 + 0.3,
            alpha: Math.random(),
            speed: Math.random() * 0.03 + 0.005,
            phase: Math.random() * Math.PI * 2,
            drift: Math.random() * 2
        });
    }
}

let time = 0;

function drawBase() {

    const x = width / 2;
    const y = height / 2 + 155;

    const glow = ctx.createRadialGradient(
        x, y, 2,
        x, y, 85
    );

    glow.addColorStop(0, "rgba(0,220,255,0.9)");
    glow.addColorStop(0.3, "rgba(0,120,255,0.35)");
    glow.addColorStop(1, "rgba(0,0,255,0)");

    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.ellipse(x, y, 85, 23, 0, 0, Math.PI * 2);
    ctx.fill();

    // Bright center
    ctx.shadowBlur = 25;
    ctx.shadowColor = "#00cfff";
    ctx.fillStyle = "#00dfff";

    ctx.beginPath();
    ctx.ellipse(x, y, 32, 4, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.shadowBlur = 0;
}

function drawParticles() {

    particles.forEach(p => {

        p.alpha = 0.4 + Math.sin(time * p.speed * 20 + p.phase) * 0.6;

        const floatY = Math.sin(time * 0.02 + p.phase) * p.drift;

        ctx.beginPath();

        ctx.arc(
            p.x,
            p.y + floatY,
            p.size,
            0,
            Math.PI * 2
        );

        ctx.fillStyle = `rgba(30,150,255,${p.alpha})`;

        ctx.shadowBlur = 8;
        ctx.shadowColor = "#008cff";

        ctx.fill();
    });

    ctx.shadowBlur = 0;
}

// Floating particles around heart
function drawFloatingParticles() {

    for (let i = 0; i < 5; i++) {

        const x = width / 2 + (Math.random() - 0.5) * 180;
        const y = height / 2 - 100 + Math.random() * 150;

        ctx.beginPath();
        ctx.arc(x, y, Math.random() * 1.5, 0, Math.PI * 2);

        ctx.fillStyle = "rgba(40,170,255,0.7)";
        ctx.fill();
    }
}

// Animation
function animate() {

    ctx.clearRect(0, 0, width, height);

    time++;

    drawBase();
    drawParticles();
    drawFloatingParticles();

    requestAnimationFrame(animate);
}

resize();
animate();

</script>

</body>
  </html>
  
